FROM python:3.11-slim

ENV PIP_NO_CACHE_DIR=1
RUN pip install mlflow==2.9.2 sqlalchemy==2.0.36 alembic==1.13.3

WORKDIR /mlflow
EXPOSE 5000

# Serveur de tracking + registry. Métadonnées en SQLite, artefacts servis par HTTP
# (--serve-artifacts) : les clients n'ont pas besoin d'accéder au disque du serveur.
CMD ["mlflow", "server", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--serve-artifacts", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--default-artifact-root", "mlflow-artifacts:/"]
