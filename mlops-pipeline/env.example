# Configuration de l'environnement
# Copier ce fichier en .env et remplir les valeurs

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_URI=models:/
MLFLOW_DEFAULT_ARTIFACT_ROOT=./mlruns

# Base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlops
TIMESCALEDB_URL=postgresql://postgres:postgres@localhost:5432/mlops

# DVC Storage (optionnel)
DVC_REMOTE=s3://your-bucket/mlops-data
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Docker Registry (optionnel)
DOCKER_REGISTRY=your-registry.com
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password

# Monitoring
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your-grafana-api-key

# API
API_KEY=your-api-key-here
LOG_LEVEL=INFO

# Secrets (à générer)
SECRET_KEY=generate-a-random-secret-key-here

