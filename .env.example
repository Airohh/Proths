# Copier vers .env si besoin. Rien n'est obligatoire : les défauts sont dans config/config.yaml.

# MLflow : SQLite local par défaut ; décommenter pour viser le serveur de la stack Compose.
# MLFLOW_TRACKING_URI=http://localhost:5000

# Journal des prédictions et données préparées
# PREDICTIONS_DB=data/predictions.db
# DATA_DIR=data/processed

# Boucle
# MONITOR_INTERVAL=60        # secondes entre deux passages du monitor
# RETRAIN_COOLDOWN=600       # secondes minimum entre deux retrains
# MODEL_POLL_SECONDS=30      # l'API vérifie l'alias @champion ; 0 = désactivé

LOG_LEVEL=INFO
